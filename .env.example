# Copy to .env and fill in the first and third settings: cp .env.example .env

# This host's address on your LAN, e.g. 192.168.1.74; the hub listens only here.
# Give the host a DHCP reservation so the address stays put.
HUB_BIND=
# Port on that address. Change it here, then: docker compose up -d
HUB_PORT=28677
# Networks allowed to connect, as comma-separated CIDRs, e.g. 192.168.1.0/24. Everything else is refused.
HUB_ALLOW=
# Pane order, left to right (machine ids, e.g. gpu-rig,z13,gaming-rig). Unlisted machines follow alphabetically.
HUB_ORDER=
